# GrowthPilot Agent — 环境变量样例（复制为 .env 使用；.env 已 gitignore，key 绝不进 git）
#
# 通道速查（由 GPA_LLM_BASE_URL 自动识别，换脑不改代码）：
#   本地·Ollama 原生  http://localhost:11434          零 key（openEuler: curl -fsSL https://ollama.com/install.sh | sh）
#   本地·OpenAI 兼容  http://localhost:8000           vLLM/SGLang，自动补 /v1
#   远端·智谱 GLM     https://open.bigmodel.cn/api/paas/v4      需 key
#   远端·任意兼容     DeepSeek / OpenAI / …            需 key

# ── LLM（本地轨道全部可选；远端必填 key）─────────────────────
GPA_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GPA_LLM_MODEL=glm-4.7
GPA_LLM_API_KEY=

# 本地轨道示例（什么都不用填）：
# GPA_LLM_BASE_URL=http://localhost:11434
# GPA_LLM_MODEL=qwen3.5:14b

# 强制 Ollama 也走 OpenAI 兼容 /v1（逃生门）
# GPA_LLM_COMPAT_MODE=false

# 跨厂商兜底（仅远端→远端有意义；本地轨道的兜底是确定性降级）
# GPA_FALLBACK_ENABLED=true
# GPA_FALLBACK_BASE_URL=https://api.deepseek.com
# GPA_FALLBACK_MODEL=deepseek-chat
# GPA_FALLBACK_API_KEY=

# ── 编排与闸门 ─────────────────────────────────────────────
# GPA_ORCHESTRATION_MODE=agent          # agent（默认）| workflow
# GPA_KPI_GATE=on                       # on | annotate | off
# GPA_KPI_GATE_THRESHOLD=0.0            # 容忍的不可回溯断言比例（0=零容忍）
# GPA_AGENT_MAX_STEPS=12                # agent⇄tools 步数硬上限（弱模型防死循环）
# GPA_MAX_REFINEMENT_ROUNDS=2
# GPA_BUDGET_APPROVAL_THRESHOLD=10000   # HITL 审批预算阈值（CNY）

# ── 记忆（SQLite 单文件；遗留 v8 JSON 首次启动自动迁移）──────
# GPA_MEMORY_DB_PATH=./data/memory/memory.db

# ── 数据库 / 认证（生产必改）────────────────────────────────
# GPA_DB_URL=postgresql+asyncpg://gpa:gpa@localhost:5432/growth_pilot
# GPA_JWT_SECRET=change-me-in-production
# GPA_DEMO_MODE=false
